{
  "version": "0.2.0",
  "configurations": [
    {
      // macOS: CodeLLDB drives lldb natively; cppdbg's lldb-mi hangs on step in/over
      "name": "Debug example (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/${fileBasenameNoExtension}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cmake: build",
      "initCommands": [
        "settings set target.process.thread.step-avoid-regexp ^std::"
      ]
    },
    {
      "name": "Debug example (step into OpenFHE)",
      "type": "cppdbg",
      "request": "launch",
      // debugs the file open in the editor: <name>.cpp -> build/<name>
      "program": "${workspaceFolder}/build/${fileBasenameNoExtension}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cmake: build",
      // F11 skips std:: / shared_ptr plumbing and goes straight into OpenFHE
      "osx": {
        "MIMode": "lldb",
        "setupCommands": [
          { "text": "settings set target.process.thread.step-avoid-regexp ^std::", "ignoreFailures": true }
        ]
      },
      "linux": {
        "MIMode": "gdb",
        "setupCommands": [
          { "text": "-enable-pretty-printing", "ignoreFailures": true },
          { "text": "skip -gfi /usr/include/c++/*", "ignoreFailures": true },
          { "text": "skip -gfi /usr/include/c++/*/*", "ignoreFailures": true },
          { "text": "skip -gfi /usr/include/c++/*/bits/*", "ignoreFailures": true }
        ]
      }
    }
  ]
}
